# このファイルを .env にコピーして値を埋める（.env はコミットされない）
# GitHub Actions では同じ名前を Secrets に登録する。

# --- Google Sheets ---
# サービスアカウントの credentials.json のパス（ローカル）
GOOGLE_CREDENTIALS_FILE=credentials.json
# Actions ではファイルではなく JSON 文字列を丸ごと渡すことも可能
GOOGLE_CREDENTIALS_JSON=
# 対象スプレッドシートID
SPREADSHEET_ID=your-spreadsheet-id

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# 送信先の身内グループID
LINE_TARGET_ID=your-line-group-id

# --- ダッシュボード ---
# GitHub Pages の公開URL（LINEメッセージにリンクとして載せる）
DASHBOARD_URL=
